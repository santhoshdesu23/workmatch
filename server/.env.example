# WorkMatch Server Configuration Template
PORT=5000
NODE_ENV=development

# Database Configuration (Leave blank for auto in-memory MongoDB in dev/testing, or supply MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/workmatch?retryWrites=true&w=majority

# Security (Cryptographically random string, minimum 32 characters in production)
JWT_SECRET=super-secret-jwt-key-workmatch-2026-min-32-chars

# Public URL of deployed frontend client (used to construct verification and password-reset links)
CLIENT_URL=http://localhost:5173

# AI Matching Engine (Optional — explainable rule-based engine is active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# EMAIL DELIVERY CONFIGURATION
# =============================================================================
# Provider selection:
#   - brevo   : Official Brevo REST API (RECOMMENDED for Render - sends to real external inboxes, free 300/day)
#   - resend  : Official Resend SDK (Requires verified domain in Resend to send to external inboxes)
#   - mock    : Local development / offline testing (prints links to console)
EMAIL_PROVIDER=brevo

# 1. Brevo Configuration (REQUIRED if EMAIL_PROVIDER=brevo)
# Obtain your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# 2. Resend Configuration (REQUIRED if EMAIL_PROVIDER=resend)
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Sender Header (REQUIRED for both Brevo and Resend)
# Must match a verified sender email in your Brevo (Senders & IP) or Resend account
EMAIL_FROM=WorkMatch Security <santhoshdesu23@gmail.com>

# =============================================================================
# RATE LIMITING STORE
# =============================================================================
# Options: memory (single-instance / dev) | redis (multi-instance cluster)
RATE_LIMIT_STORE=memory
REDIS_URL=