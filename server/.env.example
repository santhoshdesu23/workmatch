# WorkMatch Server Configuration Template
PORT=5000
NODE_ENV=development
# Leave blank to use in-memory MongoDB for local dev/testing, or supply MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/workmatch
JWT_SECRET=super-secret-jwt-key-workmatch-2026-min-32-chars
# Public URL of deployed frontend client (used to construct password-reset links and validate CORS)
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=

# Email Delivery Configuration (Official Resend SDK)
# Options: mock (in-memory queue for dev/test) | resend (REQUIRED in production; mock is prohibited)
EMAIL_PROVIDER=resend
# Resend API Key from https://resend.com/api-keys (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key_here
# Sender header: must be a verified domain on Resend (e.g. security@workmatch.app after DNS verification, or onboarding@resend.dev for test accounts)
EMAIL_FROM=WorkMatch Security <security@workmatch.app>

# Distributed Rate Limiting Configuration
# Options: memory (single-instance / dev) | redis (multi-instance cluster)
RATE_LIMIT_STORE=memory
REDIS_URL=
