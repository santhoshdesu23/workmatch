# WorkMatch Root Environment Variables Template

# Backend Configuration
PORT=5000
NODE_ENV=development
# Leave MONGODB_URI blank to auto-use in-memory MongoDB for local development, or supply MongoDB Atlas URI
MONGODB_URI=
JWT_SECRET=super-secret-jwt-key-workmatch-2026-min-32-chars
# Public URL of deployed frontend client (used to construct password-reset links and validate CORS)
CLIENT_URL=http://localhost:5173

# AI Layer Configuration (Optional — deterministic explainable local engine fallback is always active)
GEMINI_API_KEY=

# Email Delivery Configuration (Official Resend SDK)
# Options: mock (for dev/test) | resend (REQUIRED in production)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=WorkMatch Security <security@workmatch.app>

# Rate Limiter Store (memory for single instance, redis for cluster)
RATE_LIMIT_STORE=memory
REDIS_URL=

# Frontend Configuration
VITE_API_URL=/api
