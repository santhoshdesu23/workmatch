# WorkMatch Root Environment Variables Template

# Backend Configuration
PORT=5000
NODE_ENV=development
# Leave MONGODB_URI blank to auto-use in-memory MongoDB for local development, or supply MongoDB Atlas URI
MONGODB_URI=
JWT_SECRET=super-secret-jwt-key-workmatch-2026
CLIENT_URL=http://localhost:5173

# AI Layer Configuration (Optional — deterministic explainable local engine fallback is always active)
GEMINI_API_KEY=

# Frontend Configuration
VITE_API_URL=/api
