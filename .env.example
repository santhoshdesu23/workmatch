# WorkMatch Root Environment Variables Template

# Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/workmatch?retryWrites=true&w=majority
JWT_SECRET=super-secret-jwt-key-workmatch-2026-min-32-chars
CLIENT_URL=http://localhost:5173

# AI Layer Configuration (Optional — deterministic explainable local engine fallback is always active)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery Configuration (Brevo REST API or Resend SDK)
# Options: brevo (Recommended for Render) | resend | mock (for offline dev/test)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=WorkMatch Security <santhoshdesu23@gmail.com>

# Rate Limiter Store (memory for single instance, redis for cluster)
RATE_LIMIT_STORE=memory
REDIS_URL=

# Frontend Configuration
VITE_API_URL=/api
