{
  "name": "workmatch",
  "version": "1.0.0",
  "private": true,
  "description": "WorkMatch — AI-Powered Location-Based Temporary Employment Marketplace",
  "type": "module",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm --prefix server run dev",
    "build": "npm --prefix server install",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build:server": "npm --prefix server install",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
